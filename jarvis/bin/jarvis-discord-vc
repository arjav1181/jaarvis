#!/usr/bin/env python3
"""jarvis-discord-vc — voice-channel gate (W7). status | allow USER... | join --channel ID --as USER"""
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import discord_vc as vc


def main() -> int:
    args = sys.argv[1:]
    env = dict(os.environ)
    if not args or args[0] == "status":
        print(json.dumps(vc.vc_status(env), indent=2))
        return 0
    if args[0] == "allow":
        if len(args) < 2:
            print("usage: jarvis-discord-vc allow USER_ID...");
            return 1
        p = vc.set_allowlist(args[1:])
        print(f"allowlist: {args[1:]} -> {p}")
        return 0
    if args[0] == "join":
        channel, caller = "", ""
        it = iter(args[1:])
        for a in it:
            if a == "--channel":
                channel = next(it, "")
            elif a == "--as":
                caller = next(it, "")
        res = vc.join_plan(env, channel, caller)
        print(json.dumps(res, indent=2))
        return 0 if res.get("ok") else 2
    print(__doc__.strip());
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
