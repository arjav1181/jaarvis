#!/usr/bin/env python3
"""jarvis-langfuse — tracing opt-in gate (W7). status | enable | disable"""
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import langfuse_optin as lf


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] == "status":
        print(json.dumps(lf.status(dict(os.environ)), indent=2))
        return 0
    if args[0] == "enable":
        print(json.dumps(lf.enable(), indent=2))
        return 0
    if args[0] == "disable":
        print(json.dumps(lf.disable(), indent=2))
        return 0
    print(__doc__.strip());
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
