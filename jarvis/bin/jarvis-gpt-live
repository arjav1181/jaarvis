#!/usr/bin/env python3
"""jarvis-gpt-live — opt-in mouth gate (W7). status | enable [--i-accept-costs] | disable"""
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import gpt_live as gl


def main() -> int:
    args = sys.argv[1:]
    env = dict(os.environ)
    if not args or args[0] == "status":
        print(json.dumps(gl.status(env), indent=2))
        return 0
    if args[0] == "enable":
        res = gl.enable(env, accept_costs="--i-accept-costs" in args)
        if not res.get("ok"):
            print(res.get("disclosure", ""))
            print(json.dumps({k: v for k, v in res.items() if k != "disclosure"}, indent=2))
            return 2
        print(json.dumps(res, indent=2))
        return 0
    if args[0] == "disable":
        print(json.dumps(gl.disable(), indent=2))
        return 0
    print(__doc__.strip());
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
