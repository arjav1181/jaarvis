#!/usr/bin/env python3
"""jarvis-achieve — achievements engine (W7). record <kind> [detail] | list"""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import achievements as ac


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] not in ("record", "list"):
        print(__doc__.strip());
        return 1
    if args[0] == "record":
        if len(args) < 2:
            print("usage: jarvis-achieve record <kind> [detail]");
            return 1
        print(json.dumps(ac.record(args[1], " ".join(args[2:])), indent=2))
        return 0
    print(json.dumps(ac.summary(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
