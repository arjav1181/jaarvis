#!/usr/bin/env python3
"""jarvis-apex-say — streaming sentence TTS on the CLI (W7). [--dry-run] <text...>"""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import say


def main() -> int:
    args = sys.argv[1:]
    dry = "--dry-run" in args
    text = " ".join(a for a in args if a != "--dry-run")
    if not text:
        print(__doc__.strip());
        return 1
    res = say.speak_stream(text, dry_run=dry)
    for r in res["rows"]:
        mark = "ok" if r["ok"] else "FAIL"
        print(f"[{r['index'] + 1}/{res['sentences']}] {r['chars']}ch {r['ms']}ms {mark}")
    print(json.dumps({"sentences": res["sentences"], "elapsed_ms": res["elapsed_ms"],
                      "all_ok": res["all_ok"], "dry_run": dry}))
    return 0 if res["all_ok"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
