#!/usr/bin/env python3
"""jarvis-review — jarvis-review MoA preset (W7). check | plan <task...>"""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import review


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] not in ("check", "plan"):
        print(__doc__.strip());
        return 1
    preset = review.load_preset()
    if args[0] == "check":
        print(json.dumps(review.check_preset(preset), indent=2))
        return 0
    res = review.plan(preset, " ".join(args[1:]))
    print(json.dumps(res, indent=2))
    return 0 if res.get("ok") else 2


if __name__ == "__main__":
    raise SystemExit(main())
