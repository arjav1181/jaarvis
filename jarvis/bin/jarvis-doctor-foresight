#!/usr/bin/env python3
"""jarvis-doctor-foresight — print the foresight snapshot JSON (W10). The nightly job redirects stdout to web_dist_overlay/foresight-snapshot.json."""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.foresight import snapshot


def main() -> int:
    print(json.dumps(snapshot.build(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
