#!/usr/bin/env python3
"""jarvis-doctor-hands — print the hands snapshot JSON (W11). Redirect stdout to web_dist_overlay/hands-snapshot.json on deploy."""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.hands import snapshot


def main() -> int:
    print(json.dumps(snapshot.build(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
