#!/usr/bin/env python3
"""jarvis-doctor-apex — GPU ladder + STT engines + feature gates, one JSON (W7)."""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from jarvis.apex import snapshot


def main() -> int:
    print(json.dumps(snapshot.build(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
